# Copy to .env in the project root (server/.env also works), or set these as real environment variables.
HEALTHCHECK_PASSWORD=
PORT=4000
HOST=127.0.0.1
HEARTBEAT_INTERVAL_CRON=*/30 * * * *

START_ATTEMPTS=3
START_RETRY_DELAY_S=5
START_PARALLEL=4
START_STAGGER_S=6
PORT_RELEASE_WAIT_S=30
START_HINT_AFTER_S=30

# Artemis report after each start/restart (DLQ, ExpiryQueue, memory)
ARTEMIS_USER=loyalty_management
ARTEMIS_PASSWORD=
ARTEMIS_URL=tcp://localhost:61616
ARTEMIS_MEMORY_DANGER_PERCENT=50
